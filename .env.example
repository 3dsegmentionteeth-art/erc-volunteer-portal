# Copy to .env and adjust for your environment. DEVELOPMENT defaults shown.

# Server
NODE_ENV=development
PORT=4000
PUBLIC_HOST=http://localhost:4000

# Postgres (matches docker-compose dev stack)
DATABASE_URL=postgresql://erc:erc_dev_password@localhost:5432/erc_portal?schema=public

# Redis (used for BullMQ background jobs)
REDIS_URL=redis://localhost:6379

# Sessions + CSRF — MUST be strong random values outside development
SESSION_SECRET=dev-only-session-secret-change-me
CSRF_SECRET=dev-only-csrf-secret-change-me

# Object storage (MinIO dev stack)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=erc_dev
MINIO_SECRET_KEY=erc_dev_secret
MINIO_BUCKET=erc-documents
MINIO_USE_SSL=false

# Rate limiting (auth endpoints). Units: requests / windowMs
AUTH_LOGIN_RATE_LIMIT=20
AUTH_LOGIN_RATE_WINDOW_MS=900000
AUTH_LOGIN_SLOW_DOWN_AFTER=5
AUTH_LOGIN_SLOW_DOWN_MS=300
AUTH_REGISTER_RATE_LIMIT=5
AUTH_REGISTER_RATE_WINDOW_MS=900000

# Email verification tokens (issued after an approved registration)
AUTH_VERIFY_RATE_LIMIT=20
AUTH_VERIFY_RATE_WINDOW_MS=900000
EMAIL_VERIFICATION_TTL_MS=86400000

# Registration documents (upload limits; units: requests / windowMs, bytes)
DOCUMENT_UPLOAD_RATE_LIMIT=20
DOCUMENT_UPLOAD_RATE_WINDOW_MS=900000
DOCUMENT_MAX_BYTES=5242880
DOCUMENT_PRESIGNED_TTL_SECONDS=300
# DOCUMENT_ALLOWED_MIME_TYPES=image/png,image/jpeg,image/webp,application/pdf

# Volunteer time requests (add / edit): per-IP limit; max minutes per request;
# volunteers may correct an approved record only within this edit window.
TIME_REQUEST_RATE_LIMIT=20
TIME_REQUEST_RATE_WINDOW_MS=900000
# TIME_MAX_MINUTES_PER_REQUEST=1440
# TIME_EDIT_REQUEST_WINDOW_DAYS=14
# TIME_ADMIN_ACTION_RATE_LIMIT=60
# TIME_ADMIN_ACTION_RATE_WINDOW_MS=900000

# SMTP (email delivery). Leave SMTP_HOST empty in development: the portal then
# logs verification links instead of sending mail (never do that in production).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ERC Volunteer Service Portal <noreply@erc.local>
SMTP_SECURE=false